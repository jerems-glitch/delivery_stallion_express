<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show dynamic transit time beside delivery method -->
    <template id="delivery_method_with_transit"
              inherit_id="website_sale.delivery_carrier_selection">
        <xpath expr="//t[@t-foreach='deliveries']//span[hasclass('o_delivery_carrier')]" position="after">
            <t t-if="delivery.last_delivery_days">
                <span class="text-muted small ms-2">
                    <t t-esc="delivery.last_delivery_days"/> days
                </span>
            </t>
        </xpath>
    </template>
</odoo>