<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show dynamic transit time beside delivery method name -->
    <template id="delivery_carrier_selection_inherit_stallion"
              inherit_id="website_sale.delivery_carrier_selection"
              name="Stallion - Show Transit Time">

        <xpath expr="//t[@t-foreach='deliveries']//span[hasclass('o_delivery_carrier')]"
               position="after">
            <t t-if="delivery.last_delivery_days">
                <span class="text-muted small ms-2">
                    <t t-esc="delivery.last_delivery_days"/> days
                </span>
            </t>
        </xpath>

    </template>
</odoo>