<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_inherit_stallion" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.stallion</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stallion Express"
                      invisible="delivery_type != 'stallion_express'">
                    <group>
                        <button name="action_sync_stallion_shipping_methods"
                                string="Sync Shipping Methods from Stallion"
                                type="object"
                                class="btn btn-primary mb-3"
                                icon="fa-refresh"/>

                        <group string="API Configuration">
                            <field name="stallion_api_token" password="True"/>
                            <field name="stallion_test_mode"/>
                            <field name="stallion_postage_type" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info mt-3">
                        <strong>How it works:</strong><br/>
                        • Click <strong>"Sync Shipping Methods from Stallion"</strong> to create all available services.<br/>
                        • Each method will now show its own correct price at checkout.<br/>
                        • You can enable/disable individual methods as needed.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>